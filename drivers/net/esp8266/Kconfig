config ESP8266_NETDEV
	bool "ESP8266/ESP01 network device driver"
	default n
	depends on NET
	select DRIVERS_WIRELESS
	select NETDEV_WIRELESS_IOCTL
	select NETDEV_WIRELESS_HANDLER
	---help---
		Enable ESP8266/ESP01 as a NuttX netdev (network interface card).
		The ESP01 module communicates with the MCU via UART AT commands
		and is presented as a standard NuttX network device.

if ESP8266_NETDEV

config ESP8266_NETDEV_AT_LINEBUF
	int "AT command line buffer size"
	default 512
	---help---
		Size of the buffer used to parse AT command responses.

config ESP8266_NETDEV_THREAD_STACKSIZE
	int "Worker thread stack size"
	default 4096
	---help---
		Stack size for the ESP8266 AT command worker thread.

config ESP8266_NETDEV_THREAD_PRIORITY
	int "Worker thread priority"
	default 100
	---help---
		Priority of the ESP8266 AT command worker thread.

endif # ESP8266_NETDEV
